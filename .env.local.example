# Copy to .env.local (gitignored, never uploaded to EAS) to point a local run at local services.
# Leave a variable out to use production for it. Restart Metro after changing this file, and
# rebuild (npx expo run:ios) after changing EXPO_PUBLIC_AUTH0_DOMAIN.

# Your local streamline-api. The simulator can use localhost; a physical phone needs your
# Mac's network address instead, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Dev Auth0 tenant, matching the issuer/audience the local API validates tokens against.
EXPO_PUBLIC_AUTH0_DOMAIN=dev-6z6sz1d404izb1ge.us.auth0.com
EXPO_PUBLIC_AUTH0_AUDIENCE=http://streamlineapiv1-qa.eba-zte7tjpb.us-west-1.elasticbeanstalk.com/
# Client id of the dev tenant's Native application (not the web SPA client).
EXPO_PUBLIC_AUTH0_CLIENT_ID=
